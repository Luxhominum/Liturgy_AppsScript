{
  "name": "functions",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node lib/test/conflictEngine.test.js",
    "seed": "tsc && node lib/scripts/seedInitialData.js",
    "migrate": "tsc && node lib/scripts/migrateSheetsToFirestore.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  },
  "private": true
}
